<Window x:Class="OsEngine.OsTrader.Gui.RobotsVps.RobotsVpsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsEngineVPS — settings" Height="900" Width="1150"
        Style="{StaticResource WindowStyleCanResize}"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="500"
        Icon="/Images/OsLogo.ico">
    <!-- Settings: the common part (all VPS) on top, a tab per VPS below, the common event log at the bottom.
         The content of a VPS tab is VpsConnectionPanel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Common to all VPS -->
        <Border Grid.Row="0" Margin="5,5,5,0" Padding="8,6" BorderThickness="1" BorderBrush="{DynamicResource PanelAltBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="All VPS (this computer)" FontWeight="Bold" Padding="0,0,0,4"/>
                    <DataGrid Name="DataGridVps" Height="96" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              SelectionMode="Single" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VPS" Width="160" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Address" Width="*" Binding="{Binding Host}"/>
                            <DataGridTextColumn Header="Connection" Width="190" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Terminals" Width="80" Binding="{Binding Terminals}"/>
                            <DataGridTextColumn Header="Auto" Width="60" Binding="{Binding Auto}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Label Content="Common settings" FontWeight="Bold" Padding="0,0,0,4"/>
                    <Button Name="ButtonMcpAccess" Content="MCP access..." Width="120" Height="26" HorizontalAlignment="Left" Click="ButtonMcpAccess_Click"
                            ToolTip="Folders whose AI agent sessions (Claude and other MCP clients) can control the terminals of all VPS"/>
                    <TextBlock Name="TextBlockMcpAccess" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Name="TextBlockPackage" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Button Name="ButtonUpdateAll" Content="Update all VPS..." Width="150" Height="26" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ButtonUpdateAll_Click"
                            ToolTip="Installs the build package of this computer on the running terminals of every connected VPS, one VPS after another. Before each VPS the open positions are shown and a confirmation is asked."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- A tab per VPS; the last tab "+" adds one -->
        <TabControl Grid.Row="1" Name="TabControlVps" Margin="5,5,5,0"/>

        <!-- Common log (the lines of all VPS) -->
        <Grid Grid.Row="2" Margin="5" Background="{DynamicResource PanelAltBrush}">
            <DataGrid Name="LogDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      Margin="5,5,1,1" Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="90" Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"/>
                    <DataGridTextColumn Header="VPS" Width="140" Binding="{Binding Vps}"/>
                    <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
