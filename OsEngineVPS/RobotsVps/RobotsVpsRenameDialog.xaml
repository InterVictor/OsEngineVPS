<Window x:Class="OsEngine.OsTrader.Gui.RobotsVps.RobotsVpsRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Height="170" Width="380" ResizeMode="NoResize" Style="{StaticResource WindowStyleNoResize}"
        WindowStartupLocation="CenterOwner" Icon="/Images/OsLogo.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Name="TextBlockHint" TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
        <TextBox Grid.Row="1" Name="TextBoxName" Margin="0,8,0,0" Height="26" MaxLength="30" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Row="2" Name="TextBlockError" Margin="0,4,0,0" Foreground="OrangeRed" FontSize="11" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Name="ButtonOk" Content="OK" Width="90" Height="26" Margin="0,0,8,0" IsDefault="True"/>
            <Button Name="ButtonCancel" Content="Cancel" Width="90" Height="26" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
