<UserControl x:Class="OsEngine.OsTrader.Gui.RobotsVps.RobotsVpsMarginSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="128" Width="400">
    <!-- Margin mode and leverage on the exchange for the securities of this tab (one security of a simple tab, the selected ones of a screener) -->
    <Grid>
        <Rectangle/>
        <Label Name="LabelTitle" Content="Margin and leverage on the exchange" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
        <Label Name="LabelMode" Content="Margin mode" HorizontalAlignment="Left" Margin="31,28,0,0" VerticalAlignment="Top"/>
        <ComboBox Name="ComboBoxMode" Margin="196,28,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="184"/>
        <Label Name="LabelLeverage" Content="Leverage" HorizontalAlignment="Left" Margin="31,55,0,0" VerticalAlignment="Top"/>
        <TextBox Name="TextBoxLeverage" Style="{StaticResource TextBoxRectangular}" Margin="196,56,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="50" Height="22" TextAlignment="Center" MaxLength="3" Text="3"/>
        <Button Name="ButtonApply" Content="Set on the exchange" Margin="256,55,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="124" Height="24" ToolTip="Sends the margin mode and leverage to the exchange for the securities of this tab"/>
        <CheckBox Name="CheckBoxPolicy" Content="Also apply to every NEW security automatically" Margin="31,86,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Collapsed" FontSize="11"/>
        <TextBlock Name="TextBlockPolicy" Margin="31,106,10,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="10" Foreground="Gray" Visibility="Collapsed"/>
        <TextBlock Name="TextBlockState" Margin="10,86,10,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Text="Margin settings: waiting for data"/>
    </Grid>
</UserControl>
