<Window x:Class="OsEngine.OsTrader.Gui.RobotsVps.RobotsVpsMigrateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Migrate terminal" SizeToContent="Height" MinHeight="300" Width="520" ResizeMode="NoResize"
        Style="{StaticResource WindowStyleNoResize}" WindowStartupLocation="CenterOwner" Icon="/Images/OsLogo.ico">
    <!-- The height follows the content. The first step of the migration: where to and under which name. -->
    <Grid Margin="14,14,14,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Name="TextBlockIntro" TextWrapping="Wrap"/>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="Target VPS" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Name="ComboBoxTarget" Height="26" VerticalContentAlignment="Center"/>
            <Label Grid.Row="1" Grid.Column="0" Content="Name of the new terminal" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="TextBoxName" Height="26" Margin="0,8,0,0" MaxLength="20" VerticalContentAlignment="Center"/>
        </Grid>
        <TextBlock Grid.Row="2" Name="TextBlockSteps" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
        <TextBlock Grid.Row="3" Name="TextBlockError" Margin="0,8,0,0" Foreground="OrangeRed" FontSize="11" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Name="ButtonOk" Content="Next..." Width="100" Height="26" Margin="0,0,8,0" IsDefault="True"/>
            <Button Name="ButtonCancel" Content="Cancel" Width="100" Height="26" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
