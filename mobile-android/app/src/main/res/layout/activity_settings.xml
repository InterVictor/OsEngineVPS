<?xml version="1.0" encoding="utf-8"?>
<net.osa.osenginemobile.BarScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">
        <LinearLayout
            android:id="@+id/content_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/back_terminals"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="‹ Терминалы"
                android:textColor="@color/orange"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="@color/brand_strip" />

            <!-- server update: the VPS fetches the newest signed release from GitHub and updates its terminals -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/update_section"
                android:textColor="@color/orange"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/update_vps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:minHeight="40dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/orange"
                    android:textSize="15sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/update_installed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_not_checked"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/update_latest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/update_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ProgressBar
                    android:id="@+id/update_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/orange"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/update_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/update_check"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_background"
                        android:gravity="center"
                        android:text="@string/update_check"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/update_apply"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/restart_outline"
                        android:gravity="center"
                        android:text="@string/update_apply"
                        android:textColor="@color/orange"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- connection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/connection_section"
                android:textColor="@color/orange"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:orientation="vertical"
                android:padding="16dp">
                <!-- one row per VPS, filled by SettingsActivity -->
                <LinearLayout
                    android:id="@+id/vps_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <TextView
                    android:id="@+id/vps_add"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/restart_outline"
                    android:gravity="center"
                    android:text="@string/vps_add_button"
                    android:textColor="@color/orange"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- how the daily profit on the terminal tile is measured -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Дневной профит на плитке терминала"
                android:textColor="@color/orange"
                android:textSize="16sp"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/day_profit_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:orientation="vertical"
                android:padding="12dp">
                <RadioButton
                    android:id="@+id/day_profit_abs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Абсолют"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/day_profit_contract"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Процент на контракт"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/day_profit_deposit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Процент от депозита"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </RadioGroup>

            <!-- about -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/about_section"
                android:textColor="@color/orange"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/about_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:padding="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</net.osa.osenginemobile.BarScrollView>
