<?xml version="1.0" encoding="utf-8"?>
<!-- One VPS on the terminals screen: its name (shown when the phone has several VPS), its resources and its terminals -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/vps_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/vps_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/vps_connect"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/restart_outline"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/vps_connect_button"
        android:textColor="@color/orange"
        android:textSize="14sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/vps_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/vps_resources_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/vps_resources"
            android:textColor="@color/orange"
            android:textSize="16sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/resource_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_background"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/cpu_value" style="@style/OsEngineMetric"
                    android:layout_width="0dp" android:layout_weight="1" android:text="CPU  —" />
                <TextView android:id="@+id/cpu_total" style="@style/OsEngineMetric"
                    android:layout_width="wrap_content" android:gravity="end"
                    android:textColor="@color/text_secondary" android:text="" />
            </LinearLayout>
            <ProgressBar android:id="@+id/cpu_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="2dp" android:max="100"
                android:progressTint="@color/orange" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/ram_value" style="@style/OsEngineMetric"
                    android:layout_width="0dp" android:layout_weight="1" android:text="RAM  —" />
                <TextView android:id="@+id/ram_total" style="@style/OsEngineMetric"
                    android:layout_width="wrap_content" android:gravity="end"
                    android:textColor="@color/text_secondary" android:text="" />
            </LinearLayout>
            <ProgressBar android:id="@+id/ram_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="2dp" android:max="100"
                android:progressTint="@color/orange" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/disk_value" style="@style/OsEngineMetric"
                    android:layout_width="0dp" android:layout_weight="1" android:text="Диск  —" />
                <TextView android:id="@+id/disk_total" style="@style/OsEngineMetric"
                    android:layout_width="wrap_content" android:gravity="end"
                    android:textColor="@color/text_secondary" android:text="" />
            </LinearLayout>
            <ProgressBar android:id="@+id/disk_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="5dp"
                android:layout_marginTop="2dp" android:max="100"
                android:progressTint="@color/orange" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/terminal_list_title"
            android:textColor="@color/orange"
            android:textSize="16sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/terminal_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
