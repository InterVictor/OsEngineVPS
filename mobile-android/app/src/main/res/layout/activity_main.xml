<?xml version="1.0" encoding="utf-8"?>
<net.osa.osenginemobile.BarScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/content_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/logo_description"
                    android:src="@drawable/os_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="OsEngine Mobile"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="18dp"
                android:background="@color/brand_strip" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/connection_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/connection_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView style="@style/OsEngineLabel" android:text="@string/vps_name_label" />
            <EditText
                android:id="@+id/vps_name"
                style="@style/OsEngineInput"
                android:hint="@string/vps_name_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLength="30" />

            <TextView style="@style/OsEngineLabel" android:text="@string/ssh_host" />
            <EditText
                android:id="@+id/ssh_host"
                style="@style/OsEngineInput"
                android:autofillHints="url"
                android:hint="@string/host_hint"
                android:imeOptions="actionNext"
                android:inputType="textUri" />

            <TextView style="@style/OsEngineLabel" android:text="@string/ssh_user" />
            <EditText
                android:id="@+id/ssh_user"
                style="@style/OsEngineInput"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:text="root" />

            <TextView
                android:id="@+id/ssh_password_label"
                style="@style/OsEngineLabel"
                android:text="@string/ssh_password" />
            <EditText
                android:id="@+id/ssh_password"
                style="@style/OsEngineInput"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />

            <CheckBox
                android:id="@+id/auto_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:buttonTint="@color/orange"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/auto_connect"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/connect_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/button_background"
                android:text="@string/connect"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/connection_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/status_not_connected"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</net.osa.osenginemobile.BarScrollView>
